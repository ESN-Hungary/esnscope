{
  "name": "esnscope",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [
    {
      "pattern": "esnscope.tools.esn.hu",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Leave empty to derive the Worker URL from each incoming request.
    "WORKER_URL": ""
  },
  "secrets": {
    "required" : [
      "ESNACCOUNT_CLIENT_ID",
      "ESNACCOUNT_CLIENT_SECRET"
      ]
  }
  // Set with `wrangler secret put ESNACCOUNT_CLIENT_ID` and
  // `wrangler secret put ESNACCOUNT_CLIENT_SECRET`.
}